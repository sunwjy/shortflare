{
  "name": "shortflare",
  "version": "0.1.0",
  "private": false,
  "description": "An open-source URL shortener designed to run in your own Cloudflare account.",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "self-hosted",
    "url-shortener"
  ],
  "homepage": "https://github.com/sunwjy/shortflare#readme",
  "bugs": {
    "url": "https://github.com/sunwjy/shortflare/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunwjy/shortflare.git"
  },
  "bin": {
    "shortflare": "./dist/bin.js"
  },
  "files": [
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/bin.*",
    "dist/cli-contract.*",
    "dist/cli.*",
    "dist/cloudflare-api.*",
    "dist/cloudflare-deployment-executor.*",
    "dist/cloudflare-observer.*",
    "dist/d1-backup.*",
    "dist/d1-deployment-journal.*",
    "dist/deployment-application.*",
    "dist/deployment-plan.*",
    "dist/deployment-runner.*",
    "dist/index.*",
    "dist/local-instance-config.*",
    "dist/node-wrangler-runner.*",
    "dist/production-application.*",
    "dist/production-recovery.*",
    "dist/recovery-plan.*",
    "dist/release-bundle.*",
    "dist/release-manifest.*",
    "dist/resolved-worker-artifacts.*",
    "dist/wrangler-adapter.*",
    "release"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/assemble-release.js && node dist/verify-package.js",
    "notices:update": "tsc -p tsconfig.build.json && node dist/generate-third-party-notices.js --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node dist/verify-package.js",
    "verify:runtime-deps": "node dist/verify-packed-runtime-dependencies.js"
  },
  "dependencies": {
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shortflare/management": "workspace:*",
    "@shortflare/redirect-worker": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "shortflareRelease": {
    "supportedSources": [
      "fresh",
      "0.0.0"
    ],
    "rollbackSafeFrom": [
      "0.0.0"
    ]
  }
}
