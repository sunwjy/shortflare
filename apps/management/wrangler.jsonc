{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortflare-management",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "REDIRECT_DOMAIN": "short.localhost",
  },
  "ratelimits": [
    {
      "name": "MANAGEMENT_SOURCE_RATE_LIMITER",
      "namespace_id": "19001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "CREDENTIAL_SOURCE_RATE_LIMITER",
      "namespace_id": "19002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "LOGIN_TARGET_RATE_LIMITER",
      "namespace_id": "19003",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "PRIVILEGED_ACTOR_RATE_LIMITER",
      "namespace_id": "19004",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "GENERAL_USER_RATE_LIMITER",
      "namespace_id": "19005",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortflare",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/drizzle/migrations",
    },
  ],
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "shortflare-events-dlq",
        "max_batch_size": 10,
        "queue": "shortflare-events",
        "max_concurrency": 1,
        "max_retries": 3,
        "max_batch_timeout": 1,
        "retry_delay": 60,
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
