{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "docs/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts"
  ]
}
